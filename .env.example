# Mode: "local" (Ollama) or "cloud" (Vercel AI Gateway)
AI_MODE=local

# --- Local model (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Cloud model (only used if AI_MODE=cloud) ---
# Set up at https://vercel.com/ai-gateway and paste the key
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-haiku-4-5

# --- Local Supabase ---
# After running `pnpm setup:supabase`, copy the printed keys here.
# SUPABASE_URL=http://localhost:54321
# SUPABASE_SERVICE_ROLE_KEY=

# --- Workspace ---
# Absolute path to the firm's working files. Defaults to ./workspace
# WORKSPACE_ROOT=/absolute/path/to/firm/files
